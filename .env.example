# QuintByte website — copy to .env.local for local development and set the same
# variables in Vercel (Project → Settings → Environment Variables).
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle: never put a secret there.

# --- Site -------------------------------------------------------------------
# Canonical origin used for metadata, sitemap, Open Graph and JSON-LD.
# Falls back to the Vercel production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Overrides the public enquiry address (default info@quintbyte.com, GDE-005 §13).
# Leave empty to use the default.
NEXT_PUBLIC_CONTACT_EMAIL=

# Booking page for every "Book a call" button (must start with https://). While empty,
# no booking button is shown and "Send a message" is the main call to action.
# Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_BOOKING_URL=

# --- Contact form: storage (optional, server-only) ---------------------------
# Stores submissions in public.contact_submissions (supabase/migrations/0001_contact_submissions.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form: email notification (optional, server-only) ----------------
# CONTACT_EMAIL_FROM must be on a domain verified in Resend, e.g. "QuintByte Website <website@your-domain>".
# CONTACT_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# With neither Supabase nor Resend configured, submissions are logged to the console in
# development and the form reports itself unavailable in production (nothing is lost silently).
