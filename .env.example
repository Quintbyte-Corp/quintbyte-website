# QuintByte website — copy to .env.local for local development and set the same
# variables in Vercel (Project → Settings → Environment Variables).
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle: never put a secret there.

# --- Site -------------------------------------------------------------------
# Canonical origin used for metadata, sitemap, Open Graph and JSON-LD.
# Falls back to the Vercel production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Overrides the public enquiry address (default info@quintbyte.com, GDE-005 §13).
# Leave empty to use the default.
NEXT_PUBLIC_CONTACT_EMAIL=

# Booking page for every "Book a call" button (must start with https://). While empty,
# no booking button is shown and "Send a message" is the main call to action.
# Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_BOOKING_URL=

# Plausible Analytics (cookie-free). The site-specific script URL from Plausible, under
# Site settings → Site installation, e.g. https://plausible.io/js/pa-XXXXXXXX.js.
# Loads on the production deployment only. Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=

# --- Contact form: storage (required for the form, server-only) ---------------
# Stores enquiries in public.enquiries and counts them for the 5-per-hour rate limit.
# Run the files in supabase/migrations/ in order first.
# SUPABASE_URL is the project URL (https://<ref>.supabase.co). SUPABASE_SECRET_KEY is a secret
# API key (sb_secret_…, Settings → API Keys); the legacy SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Key for the one-way hash of sender IPs used by the rate limit (any long random string).
# Falls back to the Supabase key when empty.
IP_HASH_SECRET=
# Protects /api/keep-alive, the daily Vercel cron (vercel.json) that keeps the Supabase
# free plan from pausing. Any long random string; set it in Vercel (production) only.
CRON_SECRET=

# --- Contact form: email (required for the form, server-only) -----------------
# CONTACT_EMAIL_FROM must be on a domain verified in Resend (SPF, DKIM, DMARC), e.g.
# "QuintByte Website <website@quintbyte.com>". CONTACT_EMAIL_TO accepts a comma-separated list.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Auto-reply to the enquirer (GDE-003 §2.2). Off unless set to "on" (decision D-09).
CONTACT_AUTOREPLY=

# Until both Supabase and Resend are configured, submissions are logged to the console in
# development, and in production the form asks people to email instead (nothing is lost silently).
